{
  // Next.js build caches and test output: gigabytes of generated files
  // VS Code needn't watch or search.
  "files.watcherExclude": {
    "**/.next/**": true,
    "**/.next-test/**": true,
    "**/test-results/**": true,
    "**/playwright-report/**": true,
    "**/node_modules/**": true
  },
  "search.exclude": {
    "**/.next": true,
    "**/.next-test": true,
    "**/test-results": true,
    "**/playwright-report": true
  }
}
